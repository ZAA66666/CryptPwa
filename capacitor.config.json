{
  "appId": "com.zaa.cryptpwa",
  "appName": "CryptPwa",
  "webDir": "webapp",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 150,
      "launchAutoHide": true,
      "backgroundColor": "#00a862",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
